{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "bio": {
          ".validate": "newData.isString() && newData.val().length <= 150"
        }
      }
    },
    "usernames": {
      ".read": "auth != null",
      "$username": {
        ".read": true,
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
      }
    },
    "userPosts": {
      ".read": "auth != null"
    },
    "posts": {
      ".read": "auth != null"
    },
    "follows": {
      ".read": "auth != null"
    }
  }
}
