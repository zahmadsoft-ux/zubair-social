{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "bio": {
          ".validate": "newData.isString() && newData.val().length <= 150"
        }
      }
    },
    "usernames": {
      ".read": "auth != null",
      "$username": {
        ".read": true,
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
      }
    },
    "userPosts": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "posts": {
      ".read": "auth != null",
      "$postId": {
        ".write": "auth != null && newData.child('uid').val() === auth.uid && (!data.exists() || data.child('uid').val() === auth.uid)",
        ".validate": "newData.hasChildren(['uid','imageUrl','createdAt'])",
        "caption": {
          ".validate": "newData.isString() && newData.val().length <= 2200"
        }
      }
    },
    "follows": {
      ".read": "auth != null"
    },
    "feedPosts": {
      ".read": "auth != null",
      "$postId": {
        ".write": "auth != null && newData.child('uid').val() === auth.uid && (!data.exists() || data.child('uid').val() === auth.uid)"
      }
    }
  }
}
